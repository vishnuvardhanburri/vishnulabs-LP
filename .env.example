# Site
NEXT_PUBLIC_SITE_URL=https://vishnulabs.com
SITE_URL=https://vishnulabs.com

# PayPal checkout (set PAYPAL_ENV=sandbox for testing, live for production)
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=your_paypal_client_id
PAYPAL_CLIENT_SECRET=your_paypal_client_secret

# Outbound transactional email (used for receipt + license email + contact form)
RESEND_API_KEY=re_xxx
RESEND_FROM_EMAIL=VishnuLabs <hello@vishnulabs.com>

# Optional email overrides
STEALTH_VAULT_SALES_EMAIL=hello@vishnulabs.com
STEALTH_VAULT_SUPPORT_EMAIL=hello@vishnulabs.com

# Post-payment resources sent in email
STEALTH_VAULT_LOOM_URL=https://www.loom.com/share/replace-with-your-demo
STEALTH_VAULT_GUIDE_URL=https://vishnulabs.com/guides/stealth-vault-installation-guide.pdf
STEALTH_VAULT_LICENSE_SALT=replace-with-random-secret

# Optional Payoneer checkout URL (if unavailable, page uses mailto fallback)
NEXT_PUBLIC_PAYONEER_PAYMENT_URL=
NEXT_PUBLIC_PAYONEER_EMAIL=vishnuvardanbirri19@gmail.com

# Existing analytics
NEXT_PUBLIC_GA_ID=G-XXXXXXXXXX
